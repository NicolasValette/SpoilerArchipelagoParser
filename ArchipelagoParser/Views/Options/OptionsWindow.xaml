<Window x:Class="NoNiDev.ArchipelagoParser.Views.Options.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoNiDev.ArchipelagoParser.Views.Options"
        mc:Ignorable="d"
        Title="OptionsWindow" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="API RandoStat : "/>
                <TextBox Text="{Binding APIRandoStat}" Margin="5" MinWidth="300" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="API SOHAR : "/>
                <TextBox Text="{Binding APISOHAR}" Margin="5" MinWidth="300" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset" Command="{Binding ResetCommand}" Margin="5" HorizontalAlignment="Right" Width="75"/>
            <Button Grid.Column="1" Content="Appliquer" Command="{Binding SaveCommand}" Margin="5" HorizontalAlignment="Left" Width="75"/>
        </Grid>
    </Grid>
</Window>
